# Django settings
DEBUG=True
SECRET_KEY=django-insecure-Your-Secret-Key-Here
ALLOWED_HOSTS=localhost,127.0.0.1,localhost:8000
CSRF_TRUSTED_ORIGINS=http://127.0.0.1:8080,http://localhost:8080,http://localhost:5173

# Database
DATABASE_URL=postgresql://username:password@localhost:5432/dbname

# Redis Configuration
REDIS_URL=redis://localhost:6379/0

# Celery Configuration
CELERY_BROKER_URL=redis://localhost:6379/3
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# Judge0 Integration (for code execution)
JUDGE0_BASE_URL=http://localhost:2358
JUDGE0_API_KEY=

# Media and Storage
MEDIA_PATH=./media

# CORS Configuration
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:8080,https://your-domain.com

# Superuser credentials (for development only)
DJANGO_SUPERUSER_USERNAME=admin
DJANGO_SUPERUSER_EMAIL=admin@example.com
DJANGO_SUPERUSER_PASSWORD=YourSecurePassword123!

# Alipay Configuration (for production, remove or secure in development)
ALIPAY_APPID='your-app-id'
ALIPAY_DEBUG=True
ALIPAY_PRIVATE_KEY_PATH='.keys/app_private_key.pem'
ALIPAY_PUBLIC_KEY_PATH='.keys/alipay_public_key.pem'
ALIPAY_NOTIFY_URL='https://your-domain.com/api/v1/payments/alipay/notify/'
ALIPAY_RETURN_URL='https://your-student-domain.com/payment/pay'

# Async Code Judging System Configuration
# These settings control the behavior of the async judging system

# Redis Database for Code Judging Cache (separate from main cache)
# Use different database index to avoid interference
CODE_JUDGING_REDIS_URL=redis://localhost:6379/4

# Celery Task Settings for Code Judging
CODE_JUDGING_QUEUE_NAME=code_judging

# Worker Settings
# Number of concurrent workers
CELERY_WORKER_CONCURRENCY=4
# Disable task prefetching for fairness
CELERY_WORKER_PREFETCH_MULTIPLIER=1

# Task Settings
# 4.5 minutes soft timeout
CODE_JUDGING_TASK_SOFT_LIMIT=270
# 5 minutes hard timeout
CODE_JUDGING_TASK_HARD_LIMIT=300
# 2 minutes max wait time
CODE_JUDGING_QUEUE_TIMEOUT=120

# Logging Level for Celery
CELERY_LOG_LEVEL=INFO
CELERY_TASK_SERIALIZER=json
CELERY_RESULT_SERIALIZER=json
CELERY_ACCEPT_CONTENT=['json']